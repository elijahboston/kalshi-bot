# Kalshi API
KALSHI_API_KEY=
KALSHI_API_SECRET_FILE=.key
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# NWS / Weather APIs
# NWS API is free, no key needed
# Optional paid APIs for ensemble data:
OPENWEATHER_API_KEY=
TOMORROW_IO_API_KEY=

# Bot config
DRY_RUN=true
DB_PATH=./data/kalshi-bot.db
LOG_LEVEL=info
EDGE_THRESHOLD=0.12
MIN_CONFIDENCE=0.65
MAX_KELLY_FRACTION=0.025
MAX_OPEN_POSITIONS=6
MAX_CONTRACTS_PER_ORDER=15

# Exit strategy
EXIT_EDGE_THRESHOLD=0.03
STOP_LOSS_PCT=0.25
EXIT_TIME_DAYS_BEFORE_CLOSE=0.25
EXIT_TIME_MIN_EDGE=0.08

# Optional: for AI-powered explain command
ANTHROPIC_API_KEY=
